# ── UrbanRelay AI — Environment Variables ──────────────────────────
# Copy this file to .env and fill in values for production deployment.
# All variables have safe defaults for local development.

# Security — CHANGE THIS in production!
SECRET_KEY=change-me-to-a-random-64-char-string

# Database — default is zero-setup SQLite
# For PostgreSQL: postgresql://user:password@host:5432/urbanrelay
DATABASE_URL=sqlite:///urbanrelay.db

# CORS — JSON list or comma-separated origins
# Example: ["https://your-app.onrender.com", "chrome-extension://*"]
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","chrome-extension://*"]

# Frontend dist path — where the built React app lives
# Default works in the repo tree; override if deployed differently
# FRONTEND_DIST=/app/frontend/dist

# Simulation defaults (optional)
# SIM_TICK_SECONDS=1.0
# SIM_DEFAULT_SPEED=1.0
# SIM_SEED=42
# SIM_REOPT_INTERVAL=150.0

# Debug mode (optional)
# DEBUG=false
